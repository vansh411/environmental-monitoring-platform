# ============================================
# DATA - NEVER COMMIT DATASETS!
# ============================================
data/
data/**
*.zip
*.tar
*.gz
*.rar
*.7z
eurosat-dataset.zip

# Images - NEVER COMMIT
*.jpg
*.jpeg
*.png
*.tif
*.tiff
*.gif
*.bmp
*.svg

# Keep directory structure only
!data/.gitkeep
!data/eurosat/.gitkeep

# ============================================
# MODELS - NEVER COMMIT LARGE FILES
# ============================================
*.h5
*.hdf5
*.pb
*.pth
*.pt
*.onnx
*.weights
*.ckpt
models/
models/**
!models/.gitkeep
!models/checkpoints/.gitkeep

# TensorFlow/Keras cache
tfhub_cache/
.keras/

# ============================================
# PYTHON
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
.venv
*.egg-info/
dist/
build/

# ============================================
# JUPYTER
# ============================================
.ipynb_checkpoints/
*.ipynb

# ============================================
# ENVIRONMENT
# ============================================
.env
.env.local
.env.*.local

# ============================================
# IDEs
# ============================================
.vscode/
.idea/
*.swp
*.swo
*~

# ============================================
# OS
# ============================================
.DS_Store
Thumbs.db
desktop.ini

# ============================================
# LOGS & TESTING
# ============================================
*.log
logs/
.pytest_cache/
.coverage
htmlcov/

# ============================================
# TEMPORARY
# ============================================
temp/
tmp/
*.tmp